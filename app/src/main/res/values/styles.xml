<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.EHM.PageTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/ehm_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.EHM.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/ehm_on_surface_variant</item>
    </style>
    <style name="TextAppearance.EHM.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ehm_on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.EHM.CardTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ehm_on_surface</item>
    </style>
    <style name="TextAppearance.EHM.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ehm_on_surface</item>
    </style>
    <style name="TextAppearance.EHM.Support" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ehm_on_surface_variant</item>
    </style>
    <style name="TextAppearance.EHM.HeroCondition" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ehm_primary</item>
    </style>
    <style name="TextAppearance.EHM.MetricValue" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ehm_on_surface</item>
    </style>
    <style name="TextAppearance.EHM.StatValue" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ehm_primary</item>
    </style>
    <style name="Widget.EHM.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/ehm_surface</item>
        <item name="strokeColor">@color/ehm_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.EHM.Card.Tonal" parent="Widget.EHM.Card">
        <item name="cardBackgroundColor">@color/ehm_surface_tonal</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.EHM.Card.Ai" parent="Widget.EHM.Card">
        <item name="cardBackgroundColor">@color/ehm_ai_container</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/ehm_ai_accent</item>
    </style>
    <style name="Widget.EHM.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipMinHeight">40dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.EHM.BottomNavigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Widget.EHM.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">64dp</item>
        <item name="itemPaddingTop">5dp</item>
        <item name="itemPaddingBottom">5dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.EHM.BottomNavigation</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.EHM.BottomNavigation</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.EHM.BottomNavigation.ActiveIndicator</item>
    </style>
    <style name="Widget.EHM.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>
    <style name="Widget.EHM.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/control_radius</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Widget.EHM.Button.Filled" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/control_radius</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
