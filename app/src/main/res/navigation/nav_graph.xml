<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.enviroguard.app.ui.home.HomeFragment"
        android:label="Dashboard" />

    <fragment
        android:id="@+id/guidanceFragment"
        android:name="com.enviroguard.app.ui.guidance.GuidanceFragment"
        android:label="Health Guidance" />

    <fragment
        android:id="@+id/reportsFragment"
        android:name="com.enviroguard.app.ui.reports.ReportsFragment"
        android:label="Trends &amp; Forecast" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.enviroguard.app.ui.history.HistoryFragment"
        android:label="History" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.enviroguard.app.ui.settings.SettingsFragment"
        android:label="Settings" />

    <fragment
        android:id="@+id/connectFragment"
        android:name="com.enviroguard.app.ui.connect.ConnectFragment"
        android:label="Connect">
        <argument
            android:name="mode"
            android:defaultValue="add"
            app:argType="string" />
    </fragment>

</navigation>
