<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ehm_background"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="@dimen/space_20"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="104dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Health Guidance" android:textAppearance="@style/TextAppearance.EHM.PageTitle" />
        <TextView android:id="@+id/tvGuidanceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="Waiting for environmental data..." android:textAppearance="@style/TextAppearance.EHM.Support" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.EHM.Card.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_20">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CURRENT CONDITION" android:textAppearance="@style/TextAppearance.EHM.Support" android:textStyle="bold" />
                <TextView android:id="@+id/tvGuidanceCondition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:background="@drawable/bg_condition_chip" android:text="Unavailable" android:textSize="26sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:text="Main concern" android:textAppearance="@style/TextAppearance.EHM.Support" />
                <TextView android:id="@+id/tvGuidanceConcerns" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="No current assessment" android:textAppearance="@style/TextAppearance.EHM.SectionTitle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:layout_marginBottom="@dimen/space_12" android:text="Recommended guidance" android:textAppearance="@style/TextAppearance.EHM.SectionTitle" />
        <LinearLayout android:id="@+id/guidanceContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAskAi"
            style="@style/Widget.EHM.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="Ask AI About My Environment"
            app:icon="@drawable/ic_guidance" />

        <TextView android:id="@+id/tvAiStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:gravity="center" android:text="" android:textAppearance="@style/TextAppearance.EHM.Support" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:text="General environmental guidance only. This application does not provide medical diagnosis or emergency advice." android:textAppearance="@style/TextAppearance.EHM.Support" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
