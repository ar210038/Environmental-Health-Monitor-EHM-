<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F7F6">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textSize="22sp" android:textStyle="bold" android:textColor="#1A3A50" android:layout_marginBottom="14dp"/>
  <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginBottom="14dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monitoring preferences" android:textStyle="bold" android:textColor="#1A3A50"/><Switch android:id="@+id/switchNotifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Environmental condition notifications" android:textColor="#1A3A50" android:layout_marginTop="10dp"/><Switch android:id="@+id/switchDemoMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Demo mode" android:textColor="#1A3A50" android:layout_marginTop="8dp"/><TextView android:id="@+id/tvTempUnitStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Currently showing Celsius" android:textColor="#5B6664" android:layout_marginTop="12dp"/><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_tab_track" android:padding="3dp" android:layout_marginTop="6dp"><TextView android:id="@+id/btnCelsius" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="°C" android:textColor="#1A6B8A" android:textStyle="bold" android:padding="12dp"/><TextView android:id="@+id/btnFahrenheit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="°F" android:textColor="#1A6B8A" android:textStyle="bold" android:padding="12dp"/></LinearLayout></LinearLayout></androidx.cardview.widget.CardView>
  <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginBottom="14dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Device" android:textStyle="bold" android:textColor="#1A3A50"/><TextView android:id="@+id/tvCurrentDevice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No device configured" android:textColor="#5B6664" android:layout_marginTop="8dp"/><TextView android:id="@+id/btnSetUpDevice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Set up device" android:textAlignment="center" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/bg_button_primary" android:padding="13dp" android:layout_marginTop="12dp"/><TextView android:id="@+id/btnChangeWifi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Change Device Wi-Fi" android:textAlignment="center" android:textStyle="bold" android:textColor="#1A6B8A" android:background="@drawable/bg_button_outline" android:padding="13dp" android:layout_marginTop="8dp"/><TextView android:id="@+id/btnForgetDevice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Forget current device" android:textAlignment="center" android:textStyle="bold" android:textColor="#993C1D" android:padding="13dp" android:layout_marginTop="4dp"/></LinearLayout></androidx.cardview.widget.CardView>
  <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginBottom="14dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Research dataset" android:textStyle="bold" android:textColor="#1A3A50"/><TextView android:id="@+id/tvCollectedSamples" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Collected raw samples: 0" android:textColor="#5B6664" android:layout_marginTop="8dp"/><TextView android:id="@+id/btnExportDataset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Export raw dataset" android:textAlignment="center" android:textStyle="bold" android:textColor="#1A6B8A" android:background="@drawable/bg_button_outline" android:padding="13dp" android:layout_marginTop="10dp"/><TextView android:id="@+id/tvExportStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#5B6664" android:textSize="12sp" android:layout_marginTop="6dp"/></LinearLayout></androidx.cardview.widget.CardView>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Device Wi-Fi provisioning will be completed in the device setup step." android:textColor="#5B6664" android:textSize="12sp" android:layout_marginBottom="12dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Environmental Health Monitor (EHM)\nGeneral environmental guidance only. Not a certified measurement or medical diagnosis." android:textColor="#5B6664" android:textSize="12sp" android:layout_marginBottom="20dp"/>
 </LinearLayout>
</androidx.core.widget.NestedScrollView>
