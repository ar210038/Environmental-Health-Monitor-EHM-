<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A3A50"
            android:layout_marginBottom="16dp" />

        <!-- DEVICE STATUS CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Device Status"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1A3A50" />

                    <TextView
                        android:id="@+id/tvDeviceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Online"
                        android:textSize="12sp"
                        android:textColor="#0F6E56" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDeviceId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Device ID: Not connected"
                    android:textSize="12sp"
                    android:textColor="#9AA5A3"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvDeviceWifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WiFi: --"
                    android:textSize="12sp"
                    android:textColor="#9AA5A3" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ALERT THRESHOLDS CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Alert Thresholds"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A3A50"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Saved alert preferences; the environmental condition is calculated independently from factor thresholds."
                    android:textSize="12sp"
                    android:textColor="#9AA5A3"
                    android:layout_marginBottom="16dp" />

                <!-- ERS threshold -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ERS Alert Level"
                        android:textSize="13sp"
                        android:textColor="#1A3A50" />

                    <TextView
                        android:id="@+id/tvErsThresholdValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1A6B8A" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderErs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="#1A6B8A"
                    android:thumbTint="#1A6B8A"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone" />

                <!-- TVOC threshold -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TVOC Alert (ppb)"
                        android:textSize="13sp"
                        android:textColor="#1A3A50" />

                    <TextView
                        android:id="@+id/tvTvocThresholdValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="220"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#993C1D" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderTvoc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    android:progress="220"
                    android:progressTint="#993C1D"
                    android:thumbTint="#993C1D"
                    android:layout_marginBottom="16dp" />

                <!-- eCO2 threshold -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="eCO₂ Alert (ppm)"
                        android:textSize="13sp"
                        android:textColor="#1A3A50" />

                    <TextView
                        android:id="@+id/tvEco2ThresholdValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1000"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#993C1D" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderEco2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="3000"
                    android:progress="1000"
                    android:progressTint="#993C1D"
                    android:thumbTint="#993C1D"
                    android:layout_marginBottom="16dp" />

                <!-- Noise threshold -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Noise Alert (dB)"
                        android:textSize="13sp"
                        android:textColor="#1A3A50" />

                    <TextView
                        android:id="@+id/tvNoiseThresholdValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="55"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1A6B8A" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderNoise"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="55"
                    android:progressTint="#1A6B8A"
                    android:thumbTint="#1A6B8A" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TOGGLES CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Notifications toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Push Notifications"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A3A50" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instant alerts when risk is detected"
                            android:textSize="12sp"
                            android:textColor="#9AA5A3" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switchNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginBottom="16dp" />

                <!-- Temperature unit toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Temperature Unit"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A3A50" />

                        <TextView
                            android:id="@+id/tvTempUnitDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Currently showing Celsius"
                            android:textSize="12sp"
                            android:textColor="#9AA5A3" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_tab_track"
                        android:padding="3dp">

                        <TextView
                            android:id="@+id/btnCelsius"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="°C"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1A6B8A"
                            android:background="@drawable/bg_tab_active"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp" />

                        <TextView
                            android:id="@+id/btnFahrenheit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="°F"
                            android:textSize="13sp"
                            android:textColor="#9AA5A3"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- DEMO MODE CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E6F1FB"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧪 Demo Mode"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1A6B8A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simulate sensor values to test the app interface without hardware"
                        android:textSize="12sp"
                        android:textColor="#5B6664"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchDemoMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- DATASET COLLECTION CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dataset Collection"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A3A50" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Optional research sessions group related readings for later evaluation. Normal monitoring does not require a session."
                    android:textSize="12sp"
                    android:textColor="#5B6664"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvCollectionSessionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No research collection session active"
                    android:textSize="12sp"
                    android:textColor="#5B6664"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/btnToggleCollectionSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start Data Collection Session"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1A6B8A"
                    android:textAlignment="center"
                    android:background="@drawable/bg_button_outline"
                    android:padding="12dp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tvCollectedSamples"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Collected Samples: 0"
                    android:textSize="12sp"
                    android:textColor="#5B6664"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/btnExportDataset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Export Dataset"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textAlignment="center"
                    android:background="@drawable/bg_button_primary"
                    android:padding="12dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ABOUT CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="80dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="About"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A3A50"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EnviroGuard"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1A6B8A"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Version 1.0.0"
                    android:textSize="12sp"
                    android:textColor="#9AA5A3"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ML Model: Random Forest (ONNX Runtime)"
                    android:textSize="12sp"
                    android:textColor="#9AA5A3"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sensors: DHT22 · SGP30 · INMP441"
                    android:textSize="12sp"
                    android:textColor="#9AA5A3" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
