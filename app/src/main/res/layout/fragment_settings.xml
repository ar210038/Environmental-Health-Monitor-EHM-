<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ehm_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="@dimen/space_32">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Go back" android:padding="12dp" android:src="@drawable/ic_arrow_back" app:tint="@color/ehm_on_surface" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8" android:layout_weight="1" android:text="Settings" android:textAppearance="@style/TextAppearance.EHM.PageTitle" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:text="DEVICE" android:textAppearance="@style/TextAppearance.EHM.Eyebrow" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.EHM.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/card_padding">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="@dimen/icon_container_size" android:layout_height="@dimen/icon_container_size" android:background="@drawable/bg_icon_container" android:contentDescription="Current monitoring device" android:padding="10dp" android:src="@drawable/ic_device" app:tint="@color/ehm_primary" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvCurrentDeviceName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No monitoring device" android:textAppearance="@style/TextAppearance.EHM.CardTitle" android:textStyle="bold" />
                        <TextView android:id="@+id/tvCurrentDeviceId" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Not configured" android:textAppearance="@style/TextAppearance.EHM.Support" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvCurrentDeviceBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_condition_chip" android:text="CURRENT" android:textColor="@color/ehm_primary" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
                </LinearLayout>
                <TextView android:id="@+id/tvDeviceCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:text="No registered devices" android:textAppearance="@style/TextAppearance.EHM.Support" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnManageDevices" style="@style/Widget.EHM.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:text="Manage" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnChangeWifi" style="@style/Widget.EHM.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:text="Change Wi-Fi" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSetUpDevice" style="@style/Widget.EHM.Button.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="Add monitoring device" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnForgetDevice" style="@style/Widget.EHM.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="Forget current device" android:textColor="@color/ehm_error" app:strokeColor="@color/ehm_error" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:text="One monitoring device is active at a time." android:textAppearance="@style/TextAppearance.EHM.Support" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:text="MONITORING" android:textAppearance="@style/TextAppearance.EHM.Eyebrow" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.EHM.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/card_padding">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchNotifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="Environmental condition notifications" android:textAppearance="@style/TextAppearance.EHM.Body" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ehm_surface_variant" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:text="Temperature unit" android:textAppearance="@style/TextAppearance.EHM.CardTitle" />
                <TextView android:id="@+id/tvTempUnitStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Currently showing Celsius" android:textAppearance="@style/TextAppearance.EHM.Support" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:background="@drawable/bg_tab_track" android:orientation="horizontal" android:padding="4dp">
                    <TextView android:id="@+id/btnCelsius" android:layout_width="64dp" android:layout_height="44dp" android:background="@drawable/bg_tab_active" android:gravity="center" android:text="°C" android:textColor="@color/ehm_primary" android:textStyle="bold" />
                    <TextView android:id="@+id/btnFahrenheit" android:layout_width="64dp" android:layout_height="44dp" android:gravity="center" android:text="°F" android:textColor="@color/ehm_on_surface_variant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:text="DATA &amp; TESTING" android:textAppearance="@style/TextAppearance.EHM.Eyebrow" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.EHM.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/card_padding">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchDemoMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_tab_track" android:minHeight="64dp" android:paddingHorizontal="@dimen/space_12" android:text="Demo mode" android:textAppearance="@style/TextAppearance.EHM.Body" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="Use clearly labelled simulated readings for demonstrations. Live monitoring resumes when disabled." android:textAppearance="@style/TextAppearance.EHM.Support" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnTestScenario" style="@style/Widget.EHM.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:text="@string/scenario_test_button"  app:icon="@drawable/ic_reports" />
                <TextView android:id="@+id/tvCollectedSamples" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:text="Collected raw samples: 0" android:textAppearance="@style/TextAppearance.EHM.Support" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnExportDataset" style="@style/Widget.EHM.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="Export raw dataset" />
                <TextView android:id="@+id/tvExportStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="" android:textAppearance="@style/TextAppearance.EHM.Support" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:text="ABOUT" android:textAppearance="@style/TextAppearance.EHM.Eyebrow" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.EHM.Card.Tonal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/card_padding">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Environmental Health Monitor" android:textAppearance="@style/TextAppearance.EHM.CardTitle" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="DHT22 temperature and humidity • SGP30 TVOC and eCO2 equivalent • INMP441 Estimated Noise Level" android:textAppearance="@style/TextAppearance.EHM.Support" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:text="SGP30 reports an eCO2 equivalent signal. The INMP441 noise level is estimated and not a calibrated sound-level measurement." android:textAppearance="@style/TextAppearance.EHM.Support" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
