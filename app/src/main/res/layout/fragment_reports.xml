<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F7F6">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingBottom="96dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trends &amp; Forecast" android:textSize="22sp" android:textStyle="bold" android:textColor="#1A3A50" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Timestamp-based summaries of recorded conditions" android:textSize="12sp" android:textColor="#5B6664" android:layout_marginBottom="14dp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_tab_track" android:padding="4dp" android:layout_marginBottom="14dp">
   <TextView android:id="@+id/tabDaily" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Today" android:gravity="center" android:padding="9dp" android:textColor="#1A6B8A" android:background="@drawable/bg_tab_active" />
   <TextView android:id="@+id/tabWeekly" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="7 Days" android:gravity="center" android:padding="9dp" android:textColor="#9AA5A3" />
   <TextView android:id="@+id/tabMonthly" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="30 Days" android:gravity="center" android:padding="9dp" android:textColor="#9AA5A3" />
  </LinearLayout>
  <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginBottom="14dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Environmental summary" android:textStyle="bold" android:textColor="#1A3A50" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thermal Concern" android:textColor="#5B6664" android:layout_marginTop="12dp"/><TextView android:id="@+id/tvThermalDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 min" android:textStyle="bold" android:textColor="#1A3A50" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Air Concern" android:textColor="#5B6664" android:layout_marginTop="10dp"/><TextView android:id="@+id/tvAirDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 min" android:textStyle="bold" android:textColor="#1A3A50" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Noise Concern" android:textColor="#5B6664" android:layout_marginTop="10dp"/><TextView android:id="@+id/tvNoiseDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 min" android:textStyle="bold" android:textColor="#1A3A50" />
   </LinearLayout>
  </androidx.cardview.widget.CardView>
  <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginBottom="14dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dominant measured contributor" android:textStyle="bold" android:textColor="#1A3A50"/><TextView android:id="@+id/tvDominantContributor" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Insufficient history" android:textColor="#1A6B8A" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="8dp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Historical pattern" android:textStyle="bold" android:textColor="#1A3A50" android:layout_marginTop="16dp"/><TextView android:id="@+id/tvHistoricalPattern" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Not enough historical data yet." android:textColor="#5B6664" android:layout_marginTop="6dp"/></LinearLayout></androidx.cardview.widget.CardView>
  <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recorded condition history" android:textStyle="bold" android:textColor="#1A3A50"/><com.github.mikephil.charting.charts.LineChart android:id="@+id/conditionChart" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="10dp"/><TextView android:id="@+id/tvTrendsEmpty" android:layout_width="match_parent" android:layout_height="120dp" android:text="Insufficient timestamped history for this period." android:gravity="center" android:textColor="#5B6664"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Forecast" android:textStyle="bold" android:textColor="#1A3A50" android:layout_marginTop="14dp"/><TextView android:id="@+id/tvForecastState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Forecast not available yet." android:textColor="#5B6664" android:layout_marginTop="6dp"/></LinearLayout></androidx.cardview.widget.CardView>
 </LinearLayout>
</androidx.core.widget.NestedScrollView>
