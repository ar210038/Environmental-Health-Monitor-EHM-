<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EnviroGuard"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A6B8A" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● No Device"
                android:textSize="12sp"
                android:textColor="#993C1D"
                android:background="@drawable/bg_pill_safe"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />
        </LinearLayout>

        <!-- LAST UPDATED -->
        <TextView
            android:id="@+id/tvLastUpdated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last updated just now"
            android:textSize="11sp"
            android:textColor="#9AA5A3"
            android:layout_marginBottom="16dp" />

        <!-- ENVIRONMENTAL CONDITION CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENVIRONMENTAL CONDITION"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textColor="#9AA5A3"
                    android:layout_marginBottom="16dp" />

                <!-- ERS RING using ProgressBar -->
                <FrameLayout
                    android:layout_width="180dp"
                    android:layout_height="180dp">

                    <!-- Track ring -->
                    <ProgressBar
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/ring_track"
                        android:rotation="-90" />

                    <!-- Progress ring -->
                    <ProgressBar
                        android:id="@+id/ersRing"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/ring_progress"
                        android:rotation="-90" />

                    <!-- Center content -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvErsScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="52sp"
                            android:textStyle="bold"
                            android:textColor="#1A6B8A" />

                        <TextView
                            android:id="@+id/tvErsClass"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Environmental Condition"
                            android:textSize="13sp"
                            android:textColor="#9AA5A3" />
                    </LinearLayout>
                </FrameLayout>

                <!-- CONDITION REASONS -->
                <TextView
                    android:id="@+id/tvMainContributor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#5B6664"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heat Index"
                    android:textStyle="bold"
                    android:textColor="#1A3A50"
                    android:layout_marginTop="14dp" />
                <TextView
                    android:id="@+id/tvHeatIndex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N/A"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1A3A50" />
                <TextView
                    android:id="@+id/tvHeatIndexStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Feels-like temperature based on air temperature and humidity"
                    android:textSize="11sp"
                    android:textColor="#5B6664" />

                <!-- SUGGESTION BOX -->
                <LinearLayout
                    android:id="@+id/suggestionBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_suggestion_box"
                    android:padding="14dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="18sp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:id="@+id/tvRecommendation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Waiting for readings..."
                        android:textSize="13sp"
                        android:textColor="#1A3A50"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- GET AI SUGGESTION BUTTON -->
                <TextView
                    android:id="@+id/btnAiSuggestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✨ Get AI Suggestion"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1A6B8A"
                    android:textAlignment="center"
                    android:background="@drawable/bg_button_outline"
                    android:padding="12dp"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- LIVE READINGS LABEL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live Readings"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A3A50"
            android:layout_marginBottom="10dp" />

        <!-- SENSOR CARDS ROW 1: Temperature + Humidity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <!-- Temperature -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EDFBF4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌡 Temperature"
                        android:textSize="11sp"
                        android:textColor="#0F6E56"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--°C"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A3A50" />

                    <TextView
                        android:id="@+id/tvTempStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safe"
                        android:textSize="11sp"
                        android:textColor="#0F6E56"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Humidity -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FEF9EE">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💧 Humidity"
                        android:textSize="11sp"
                        android:textColor="#BA7517"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvHumidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A3A50" />

                    <TextView
                        android:id="@+id/tvHumidityStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safe"
                        android:textSize="11sp"
                        android:textColor="#0F6E56"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- SENSOR CARDS ROW 2: TVOC + eCO2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <!-- TVOC -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FBEAE6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧪 TVOC"
                        android:textSize="11sp"
                        android:textColor="#993C1D"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvTvoc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ppb"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A3A50" />

                    <TextView
                        android:id="@+id/tvTvocStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safe"
                        android:textSize="11sp"
                        android:textColor="#0F6E56"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- eCO2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FBEAE6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💨 eCO₂"
                        android:textSize="11sp"
                        android:textColor="#993C1D"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvEco2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- ppm"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A3A50" />

                    <TextView
                        android:id="@+id/tvEco2Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safe"
                        android:textSize="11sp"
                        android:textColor="#0F6E56"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- SENSOR CARD ROW 3: Noise (full width) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EDFBF4"
            android:layout_marginBottom="80dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔊 Estimated Noise Level"
                        android:textSize="11sp"
                        android:textColor="#0F6E56"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvNoise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- dB"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1A3A50" />

                    <TextView
                        android:id="@+id/tvNoiseStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safe"
                        android:textSize="11sp"
                        android:textColor="#0F6E56"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- noise level bar -->
                <ProgressBar
                    android:id="@+id/noiseBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="120dp"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progress="30"
                    android:progressTint="#0F6E56"
                    android:progressBackgroundTint="#E0E0E0" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
