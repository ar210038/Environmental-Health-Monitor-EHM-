<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F7F6">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingBottom="96dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Environmental Health Monitor" android:textColor="#1A3A50" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/btnOpenSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textColor="#1A6B8A" android:textStyle="bold" android:padding="10dp" />
        </LinearLayout>
        <TextView android:id="@+id/tvConnectionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● No Device" android:textColor="#5B6664" android:textSize="12sp" />
        <TextView android:id="@+id/tvDashboardStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for environmental data" android:textColor="#5B6664" android:textSize="13sp" android:layout_marginTop="6dp" android:layout_marginBottom="16dp" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current environmental condition" android:textColor="#5B6664" android:textSize="12sp" />
                <TextView android:id="@+id/tvEnvironmentalCondition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unavailable" android:textColor="#1A6B8A" android:textSize="28sp" android:textStyle="bold" android:layout_marginTop="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Primary concerns" android:textColor="#5B6664" android:textSize="12sp" android:layout_marginTop="14dp" />
                <TextView android:id="@+id/tvPrimaryConcerns" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for data" android:textColor="#1A3A50" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Condition by dimension" android:textColor="#1A3A50" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF" android:layout_marginBottom="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thermal condition" android:textColor="#5B6664" /><TextView android:id="@+id/tvThermalCondition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unavailable" android:textColor="#1A3A50" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Air condition" android:textColor="#5B6664" android:layout_marginTop="12dp" /><TextView android:id="@+id/tvAirCondition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unavailable" android:textColor="#1A3A50" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estimated noise condition" android:textColor="#5B6664" android:layout_marginTop="12dp" /><TextView android:id="@+id/tvNoiseCondition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unavailable" android:textColor="#1A3A50" android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current readings" android:textColor="#1A3A50" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temperature" android:textColor="#5B6664" /><TextView android:id="@+id/tvTemperature" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unavailable" android:textColor="#1A3A50" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Humidity" android:textColor="#5B6664" android:layout_marginTop="10dp" /><TextView android:id="@+id/tvHumidity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unavailable" android:textColor="#1A3A50" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Heat index" android:textColor="#5B6664" android:layout_marginTop="10dp" /><TextView android:id="@+id/tvHeatIndex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unavailable" android:textColor="#1A3A50" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TVOC" android:textColor="#5B6664" android:layout_marginTop="10dp" /><TextView android:id="@+id/tvTvoc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unavailable" android:textColor="#1A3A50" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="eCO₂ equivalent" android:textColor="#5B6664" android:layout_marginTop="10dp" /><TextView android:id="@+id/tvEco2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unavailable" android:textColor="#1A3A50" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estimated noise level" android:textColor="#5B6664" android:layout_marginTop="10dp" /><TextView android:id="@+id/tvNoiseLevel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unavailable" android:textColor="#1A3A50" android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
