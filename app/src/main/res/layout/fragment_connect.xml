<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ehm_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="@dimen/space_32">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/btnBackToSettings" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Back to Settings" android:padding="12dp" android:src="@drawable/ic_arrow_back" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_8" android:layout_weight="1" android:text="Device Setup" android:textAppearance="@style/TextAppearance.EHM.PageTitle" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.EHM.Card.Tonal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="@dimen/space_24">
                <ImageView android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="Monitoring device setup" android:src="@drawable/ic_device" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:text="Provisioning not connected" android:textAppearance="@style/TextAppearance.EHM.SectionTitle" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:gravity="center" android:text="Real ESP32 SoftAP Wi-Fi provisioning will be implemented in the next phase." android:textAppearance="@style/TextAppearance.EHM.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:text="What this screen does now" android:textAppearance="@style/TextAppearance.EHM.SectionTitle" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.EHM.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/card_padding">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="• Opens your phone’s Wi-Fi settings when requested\n\n• Does not collect or store a Wi-Fi password\n\n• Does not create a fake device or connection state" android:textAppearance="@style/TextAppearance.EHM.Body" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenWifiSettings" style="@style/Widget.EHM.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:text="Open phone Wi-Fi settings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16" android:text="No device will be added until the real provisioning protocol returns a verified device identifier." android:textAppearance="@style/TextAppearance.EHM.Support" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
