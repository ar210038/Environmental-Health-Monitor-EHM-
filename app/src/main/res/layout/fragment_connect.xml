<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F7F6">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Device Setup" android:textSize="22sp" android:textStyle="bold" android:textColor="#1A3A50"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ESP32 Wi-Fi provisioning is not connected yet." android:textColor="#5B6664" android:layout_marginTop="6dp" android:layout_marginBottom="16dp"/>
  <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="18dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Not connected" android:textSize="20sp" android:textStyle="bold" android:textColor="#1A6B8A"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="This screen does not send Wi-Fi credentials or simulate a successful connection. Device provisioning will be implemented when the hardware protocol is available." android:textColor="#5B6664" android:layout_marginTop="10dp"/><TextView android:id="@+id/btnOpenWifiSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open phone Wi-Fi settings" android:textAlignment="center" android:textStyle="bold" android:textColor="#1A6B8A" android:background="@drawable/bg_button_outline" android:padding="14dp" android:layout_marginTop="16dp"/><TextView android:id="@+id/btnBackToSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Back to Settings" android:textAlignment="center" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/bg_button_primary" android:padding="14dp" android:layout_marginTop="10dp"/></LinearLayout></androidx.cardview.widget.CardView>
 </LinearLayout>
</androidx.core.widget.NestedScrollView>
