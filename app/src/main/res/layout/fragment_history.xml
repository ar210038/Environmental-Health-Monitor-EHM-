<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="History"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A3A50"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explore timestamped environmental readings"
            android:textSize="12sp"
            android:textColor="#9AA5A3"
            android:layout_marginBottom="16dp" />

        <!-- SENSOR SELECTOR CHIPS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌡 Temperature"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipHumidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp"
                    android:text="💧 Humidity"
                    android:textColor="#5B6664"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipTvoc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧪 TVOC"
                    android:textSize="13sp"
                    android:textColor="#5B6664"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipEco2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💨 eCO₂"
                    android:textSize="13sp"
                    android:textColor="#5B6664"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipNoise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊 Estimated Noise"
                    android:textSize="13sp"
                    android:textColor="#5B6664"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp" />

                <TextView
                    android:id="@+id/chipHeatIndex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌡 Heat Index"
                    android:textSize="13sp"
                    android:textColor="#5B6664"
                    android:background="@drawable/bg_chip_unselected"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginStart="8dp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- DATE RANGE TABS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_tab_track"
            android:padding="4dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/rangeToday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Today"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1A6B8A"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:background="@drawable/bg_tab_active" />

            <TextView
                android:id="@+id/range7Days"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="7 Days"
                android:textSize="12sp"
                android:textColor="#9AA5A3"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp" />

            <TextView
                android:id="@+id/range30Days"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30 Days"
                android:textSize="12sp"
                android:textColor="#9AA5A3"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp" />

            <TextView
                android:id="@+id/rangeCustom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Custom"
                android:textSize="12sp"
                android:textColor="#9AA5A3"
                android:gravity="center"
                android:paddingTop="9dp"
                android:paddingBottom="9dp" />

        </LinearLayout>

        <!-- MAIN CHART CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvHistoryChartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temperature — Today"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1A3A50"
                    android:layout_marginBottom="10dp" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/historyChart"
                    android:layout_width="match_parent"
                    android:layout_height="240dp" />
                <TextView
                    android:id="@+id/tvHistoryEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:text="No data yet for this period.\nStart collecting readings with your device."
                    android:textSize="13sp"
                    android:textColor="#9AA5A3"
                    android:gravity="center"
                    android:visibility="gone"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- MIN MAX AVG CARDS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="80dp">

            <!-- Min -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EDFBF4">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">
                    <TextView
                        android:id="@+id/tvMinValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#0F6E56" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minimum"
                        android:textSize="11sp"
                        android:textColor="#9AA5A3" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Avg -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E6F1FB">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">
                    <TextView
                        android:id="@+id/tvAvgValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1A6B8A" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Average"
                        android:textSize="11sp"
                        android:textColor="#9AA5A3" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Max -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FBEAE6">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">
                    <TextView
                        android:id="@+id/tvMaxValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#993C1D" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maximum"
                        android:textSize="11sp"
                        android:textColor="#9AA5A3" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
