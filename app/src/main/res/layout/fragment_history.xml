<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ehm_background"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="@dimen/space_20"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="104dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="History" android:textAppearance="@style/TextAppearance.EHM.PageTitle" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Explore one measured environmental metric at a time" android:textAppearance="@style/TextAppearance.EHM.Support" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:background="@drawable/bg_tab_track" android:orientation="horizontal" android:padding="4dp">
            <TextView android:id="@+id/rangeHour" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_tab_active" android:gravity="center" android:text="Hour" android:textColor="@color/ehm_primary" android:textStyle="bold" />
            <TextView android:id="@+id/rangeDay" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="Day" android:textColor="@color/ehm_on_surface_variant" />
            <TextView android:id="@+id/rangeWeek" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="Week" android:textColor="@color/ehm_on_surface_variant" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_20" android:text="Metric" android:textAppearance="@style/TextAppearance.EHM.SectionTitle" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/metricChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip android:id="@+id/chipTemperature" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Temperature" />
                <com.google.android.material.chip.Chip android:id="@+id/chipHumidity" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Humidity" />
                <com.google.android.material.chip.Chip android:id="@+id/chipHeatIndex" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Heat Index" />
                <com.google.android.material.chip.Chip android:id="@+id/chipTvoc" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TVOC" />
                <com.google.android.material.chip.Chip android:id="@+id/chipEco2" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="eCO₂" />
                <com.google.android.material.chip.Chip android:id="@+id/chipNoise" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estimated Noise" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.EHM.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_16">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/card_padding">
                <TextView android:id="@+id/tvHistoryChartTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Temperature — Hour" android:textAppearance="@style/TextAppearance.EHM.CardTitle" android:textStyle="bold" />
                <com.github.mikephil.charting.charts.LineChart android:id="@+id/historyChart" android:layout_width="match_parent" android:layout_height="280dp" android:layout_marginTop="@dimen/space_12" />
                <TextView android:id="@+id/tvHistoryEmpty" android:layout_width="match_parent" android:layout_height="220dp" android:gravity="center" android:text="No measurements are available for this period." android:textAppearance="@style/TextAppearance.EHM.Support" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_12" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.EHM.Card.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="14dp"><TextView android:id="@+id/tvMinValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/ehm_primary" android:textSize="20sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Minimum" android:textAppearance="@style/TextAppearance.EHM.Support"/></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.EHM.Card.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="4dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="14dp"><TextView android:id="@+id/tvAvgValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/ehm_primary" android:textSize="20sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Average" android:textAppearance="@style/TextAppearance.EHM.Support"/></LinearLayout></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.EHM.Card.Tonal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="14dp"><TextView android:id="@+id/tvMaxValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="@color/ehm_primary" android:textSize="20sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Maximum" android:textAppearance="@style/TextAppearance.EHM.Support"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
